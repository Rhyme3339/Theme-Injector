{
  "manifest_version": 3,
  "name": "Theme Injector",
  "version": "2.0.0",
  "description": "Apply Dark, Romance, Sky, Sea, or Magic themes to any website, remembered per site.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
